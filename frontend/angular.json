{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "fittracker-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "fit",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/fittracker-web",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "styles": ["src/styles.scss"],
            "assets": [{"glob": "**/*", "input": "public"}]
          },
          "configurations": {
            "production": {
              "optimization": {"fonts": {"inline": false}},
              "budgets": [
                {"type": "initial", "maximumWarning": "1.2MB", "maximumError": "2MB"},
                {"type": "anyComponentStyle", "maximumWarning": "30kB", "maximumError": "45kB"}
              ],
              "outputHashing": "all"
            },
            "development": {"optimization": false, "extractLicenses": false, "sourceMap": true}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {"buildTarget": "fittracker-web:build:production"},
            "development": {"buildTarget": "fittracker-web:build:development"}
          },
          "defaultConfiguration": "development",
          "options": {"proxyConfig": "proxy.conf.json"}
        }
      }
    }
  }
}
